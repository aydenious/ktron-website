---
import '@fontsource-variable/manrope';
import '../../styles/global.css';
import Logo from '../../components/Logo.astro';
import { LANGS, t, type Lang } from '../../i18n';
export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}
const lang = Astro.params.lang as Lang;
---
<html lang={LANGS[lang].htmlLang} class="on-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>KTRON</title>
  </head>
  <body>
    <div class="card">
      <div class="logo"><Logo variant="white" /></div>
      <h1>{t(lang, 'hero.title')}</h1>
      <p>{t(lang, 'hero.sub')}</p>
      <span class="url">ktron.my</span>
    </div>
  </body>
</html>
<style>
  body { margin: 0; background: var(--navy); }
  .card { box-sizing: border-box; width: 1200px; height: 630px; padding: 64px 72px; color: var(--white);
    display: grid; grid-template-rows: auto 1fr auto auto; gap: 24px; border-bottom: 14px solid var(--gold); }
  .logo :global(svg) { width: 220px; height: auto; }
  h1 { color: var(--white); font-size: 54px; line-height: 1.2; margin: 0; align-self: end; max-width: 1000px; }
  p { color: var(--gold-soft); font-size: 30px; margin: 0; }
  .url { color: var(--gold); font-size: 26px; font-weight: 800; }
</style>
