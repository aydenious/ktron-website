---
import Scene from './scene/Scene.astro';
import { STILLS } from './scene/steps';
import { t, type Key, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section id="how" class="how" data-how aria-labelledby="how-title">
  <div class="wrap">
    <h2 id="how-title">{t(lang, 'how.title')}</h2>
    <ol class="stills" data-stills role="list">
      {STILLS.map((state, i) => (
        <li data-step={i + 1}>
          <figure>
            <Scene state={state} lang={lang} />
            <figcaption>
              <span class="counter" data-counter>{t(lang, 'how.counter', { n: i + 1 })}</span>
              <span class="caption" data-caption>{t(lang, `how.${i + 1}` as Key)}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ol>
  </div>
</section>
<script>
  const section = document.querySelector<HTMLElement>('section[data-how]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // On a failed download there is nothing to undo: the five stills are the page's own fallback.
  function keepStills(): void {
    // setup never ran, so the list was never hidden and no stage was made.
  }
  if (section && !still && 'IntersectionObserver' in window) {
    // How did the reader get here? Decided from what has happened since the page loaded, never from
    // the URL alone: a hash left in the address bar (back button, reload) names nothing the reader wants.
    const FRAGMENT_SCROLL_MS = 4000; // a page load's own scroll to its fragment is over by then
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    let touched = false; // the reader has scrolled, clicked or pressed a key since the load
    let linkTarget: Element | null = null; // a header link was clicked and its scroll may still be running
    const arriving = () => !touched && performance.now() < FRAGMENT_SCROLL_MS;
    const touch = () => { touched = true; linkTarget = null; };
    for (const type of ['wheel', 'touchstart', 'keydown', 'pointerdown']) addEventListener(type, touch, { passive: true });
    addEventListener('hashchange', () => { touched = true; linkTarget = document.querySelector(':target'); });
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const deepLink = nav?.type === 'navigate' && arriving() ? document.querySelector(':target') : null;
      import('./scene/animate').then(({ setup }) => setup(section, { deepLink, linkTarget, arriving }), keepStills);
    }, { rootMargin: '200px 0px' });
    io.observe(section);
  }
</script>
<style>
  .how { padding: 64px 0; }
  .how :global(.stage) { min-height: calc(100svh - var(--header-h)); display: grid; align-content: center; padding-block: 16px; }
  .stills { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 40px; }
  figure { margin: 0; display: grid; gap: 14px; }
  figure :global(svg.scene) { width: 100%; height: auto; border-radius: var(--radius); }
  figcaption { display: grid; gap: 4px; }
  .counter { font-weight: 800; color: var(--navy-2); font-size: 0.95rem; }
  .caption { font-size: 1.15rem; }
  @media (min-width: 960px) { figure { grid-template-columns: 2fr 1fr; align-items: center; gap: 36px; } }
</style>
