---
import { Picture } from 'astro:assets';
import WhatsAppButton from './WhatsAppButton.astro';
import { photos } from '../assets/photos';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section id="top" class="hero on-dark">
  <div class="wrap grid">
    <div class="copy">
      <h1>{t(lang, 'hero.title')}</h1>
      <p class="sub">{t(lang, 'hero.sub')}</p>
      <div class="ctas">
        <WhatsAppButton lang={lang} />
        <a class="how" href="#how">{t(lang, 'hero.how')}</a>
      </div>
    </div>
    <Picture src={photos.hero} alt={t(lang, 'photo.hero.alt')} formats={['avif', 'webp']}
      widths={[480, 800, 1200]} sizes="(min-width: 960px) 50vw, 100vw"
      loading="eager" fetchpriority="high" class="photo" />
  </div>
</section>
<style>
  /* No width above 1200: hero.jpg is 1280 px wide, so a wider step would upscale it. */
  .hero { background: var(--navy); color: var(--white); padding: 40px 0 56px; }
  .grid { display: grid; gap: 32px; align-items: center; }
  h1 { color: var(--white); font-size: clamp(1.9rem, 5.5vw, 3.2rem); font-weight: 800; }
  .sub { font-size: 1.15rem; color: var(--gold-soft); margin: 0 0 28px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; }
  .how { color: var(--white); font-weight: 700; min-height: 48px; display: inline-flex; align-items: center; }
  .photo { border-radius: var(--radius); width: 100%; height: auto; }
  @media (min-width: 960px) { .grid { grid-template-columns: 1.1fr 1fr; } .hero { padding: 72px 0; } }
</style>
