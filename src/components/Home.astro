---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import WhyOutsource from './WhyOutsource.astro';
import Services from './Services.astro';
import HowItWorks from './HowItWorks.astro';
import Traceability from './Traceability.astro';
import Numbers from './Numbers.astro';
import Quality from './Quality.astro';
import ServiceArea from './ServiceArea.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import FloatingWhatsApp from './FloatingWhatsApp.astro';
import { LANGS, t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang} title={t(lang, 'meta.title')} description={t(lang, 'meta.description')} path={LANGS[lang].path} localBusiness>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <WhyOutsource lang={lang} />
    <Services lang={lang} />
    <HowItWorks lang={lang} />
    <Traceability lang={lang} />
    <Numbers lang={lang} />
    <Quality lang={lang} />
    <ServiceArea lang={lang} />
    <Faq lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
  <FloatingWhatsApp lang={lang} />
</Base>
